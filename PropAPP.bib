	issn = {1763-4229},
	shorttitle = {Approche écologique des environnements instrumentés},
	url = {https://www.cairn.info/revue-savoirs-2020-1-page-93.htm},
	abstract = {L\&\#8217;approche \&\#233;cologique de l\&\#8217;affordance permet de proposer un cadre d\&\#8217;analyse holistique de la relation sujet-artefact-environnement. Le concept d\&\#8217;affordance y est compris dans sa dimension s\&\#233;miotique et socioculturelle pour \&\#233;tudier les conditions favorisant la perception imm\&\#233;diate d\&\#8217;un artefact en vue d\&\#8217;une action. Il s\&\#8217;agit d\&\#8217;\&\#233;viter de r\&\#233;duire l\&\#8217;affordance d\&\#8217;un artefact \&\#224; ce qui en est fait mais d\&\#8217;y inclure plut\&\#244;t les conditions qui permettent de rendre compte de ce qui est possible d\&\#8217;en faire (ou non), en int\&\#233;grant dans l\&\#8217;analyse ce qui est susceptible de favoriser ou nuire au d\&\#233;veloppement humain. C\&\#8217;est ainsi que le concept d\&\#8217;affordance est compris comme un m\&\#233;diateur de la relation sujet/environnement visant la transformation de son environnement par le sujet, mettant en tension le but qu\&\#8217;il poursuit et ceux d\&\#8217;un environnement institu\&\#233; en tant que r\&\#233;sultante d\&\#8217;un ensemble de finalit\&\#233;s qui \&\#233;chappent aux intentions du sujet.},
	language = {fr},
	number = {1},
	urldate = {2020-04-22},
	journal = {Savoirs},
	publisher = {L'Harmattan},
	author = {Simonian, Stéphane},
	month = apr,
	year = {2020},
	keywords = {/unread},
	pages = {93--108},
}

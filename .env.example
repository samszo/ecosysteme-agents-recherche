# mailbot (de préférence dans .env.mailbot)
MAILBOT_PORT=7278
# boîte « historique » de chaque profil (HISTORY_<PROFIL>_IMAP_*), lue sans modification ; profil « principal » :
HISTORY_PRINCIPAL_IMAP_HOST=
HISTORY_PRINCIPAL_IMAP_PORT=993
HISTORY_PRINCIPAL_IMAP_SECURE=
HISTORY_PRINCIPAL_IMAP_USER=
HISTORY_PRINCIPAL_IMAP_PASSWORD=
# boîte du mailbot : lecture (identifiants SMTP par défaut) et envoi
BOT_IMAP_HOST=
BOT_IMAP_PORT=993
BOT_IMAP_SECURE=
BOT_IMAP_USER=
BOT_IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
